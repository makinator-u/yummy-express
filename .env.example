# Turso Database Configuration (libSQL)
# Get these from https://turso.tech or via Turso CLI (`turso db show --url <dbname>` & `turso db tokens create <dbname>`)
TURSO_DATABASE_URL="libsql://your-database-name-username.turso.io"
TURSO_AUTH_TOKEN="your-turso-auth-token-here"

# (Optional) Local SQLite Database override (default: yummy_express.db)
# DB_PATH="yummy_express.db"
